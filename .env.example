# =============================================================================
# GlobeLink — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Validation lives in src/lib/env.ts — the app refuses to boot if this is wrong.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
# One of: development | test | production. Usually set by the platform.
NODE_ENV=development

# ---- Database (PostgreSQL / Neon) ------------------------------------------
# DATABASE_URL  -> pooled connection, used by the app at runtime.
# DIRECT_URL    -> direct (unpooled) connection, used by Prisma Migrate.
#
# Neon: copy the "Pooled connection" string into DATABASE_URL and the
#       "Direct connection" string into DIRECT_URL (drop `-pooler` from the host).
# Local Postgres: set both to the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/globelink?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/globelink?schema=public"

# ---- App -------------------------------------------------------------------
# Absolute URL the app is served from. Used for metadata / absolute links and
# for building links inside transactional emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Logging -------------------------------------------------------------
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# ---- Auth.js (authentication) ------------------------------------------------
# Session/CSRF signing secret. Generate: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="generate-me"
# Set true when the host is not Vercel (local dev, self-hosting, previews).
AUTH_TRUST_HOST=true

# Google OAuth (optional). The "Continue with Google" button only appears when
# both are set. Create credentials at https://console.cloud.google.com
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Email (Resend) --------------------------------------------------------
# Optional. When RESEND_API_KEY is empty, verification emails are logged to the
# server console instead of being sent — the flow still works end to end.
# Get a key at https://resend.com.
#
# IMPORTANT: the shared "onboarding@resend.dev" sender is test-only — Resend
# rejects every recipient except your own Resend account address (HTTP 403). To
# email real users you MUST verify a sending domain at resend.com/domains and
# set EMAIL_FROM to an address on that domain, e.g. "GlobeLink <no-reply@your-domain>".
RESEND_API_KEY=""
EMAIL_FROM="GlobeLink <onboarding@resend.dev>"

# ---- AI (Anthropic) ------------------------------------------------------
# Optional. When ANTHROPIC_API_KEY is empty, AI features degrade gracefully:
# natural-language search on Explore falls back to plain text search and
# everything else is unaffected. Get a key at https://console.anthropic.com
# and set a spend cap on it (Phase 6 usage is a fraction of a cent per search).
# Also used by `npm run eval` (the AI eval harness).
ANTHROPIC_API_KEY=""

# ---- Error tracking (Sentry) -------------------------------------------
# Optional. With no DSN the Sentry SDK initialises disabled and captures
# nothing; the Sentry build plugin is also skipped, so the app builds exactly
# as before. Create a project at https://sentry.io to get a DSN.
# SENTRY_DSN=""              # server + edge runtimes
# NEXT_PUBLIC_SENTRY_DSN=""  # browser (usually the same DSN)
# SENTRY_AUTH_TOKEN=""       # optional: enables source-map upload at build
