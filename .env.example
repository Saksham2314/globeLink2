# =============================================================================
# GlobeLink — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Validation lives in src/lib/env.ts — the app refuses to boot if this is wrong.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
# One of: development | test | production. Usually set by the platform.
NODE_ENV=development

# ---- Database (PostgreSQL / Neon) ------------------------------------------
# DATABASE_URL  -> pooled connection, used by the app at runtime.
# DIRECT_URL    -> direct (unpooled) connection, used by Prisma Migrate.
#
# Neon: copy the "Pooled connection" string into DATABASE_URL and the
#       "Direct connection" string into DIRECT_URL (drop `-pooler` from the host).
# Local Postgres: set both to the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/globelink?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/globelink?schema=public"

# ---- App -------------------------------------------------------------------
# Absolute URL the app is served from. Used for metadata / absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Logging -------------------------------------------------------------
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
