// GlobeLink — Prisma schema
// Phase 1 added auth + profiles. Phase 2 adds the Journey system: a published
// trip with a day-by-day itinerary, photos and tags.
// Later phases add SavedJourney, Itinerary, Conversation, AgentSession, etc.
// per docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// An account holder. A single user can publish journeys, save journeys,
/// message other users, plan itineraries and use the AI assistant — there
/// are no mutually exclusive roles.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Null until the user confirms their email via the verification link.
  emailVerified DateTime?
  /// bcrypt hash. Null for accounts created purely via an OAuth provider.
  passwordHash  String?
  name          String?
  /// Public URL-safe identifier, e.g. globelink.app/profile/anaya
  handle        String?   @unique
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  preferences    TravelPreference?
  journeys       Journey[]
  saved          SavedJourney[]
  conversations  ConversationParticipant[]
  sentMessages   Message[]
  itineraries    Itinerary[]
  agentSessions  AgentSession[]
  agentToolCalls AgentToolCall[]
  auditLogs      AuditLog[]

  @@map("users")
}

/// Travel preferences, split out so the future AI `getUserPreferences` tool has
/// a small, stable surface and this can grow without touching User.
/// `pace`/`budgetTier` hold a fixed vocabulary enforced by Zod at the boundary
/// (see src/modules/users/user.schema.ts); kept as text for now so the first
/// auth migration stays focused — they can become Postgres enums later.
model TravelPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  styles     String[] @default([])
  pace       String?
  budgetTier String?
  interests  String[] @default([])
  homeRegion String?
  dietary    String[] @default([])
  /// UI theme choice: "light" | "dark" | "system". Null = never set (the
  /// browser-local value / OS setting applies). Mirrored to a cookie so it
  /// follows the user across devices.
  theme      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

// ---------------------------------------------------------------------------
// Auth.js (@auth/prisma-adapter) models.
// Field names are dictated by the adapter contract — do not rename.
// `Session` stays effectively unused while the JWT session strategy is in
// effect (Credentials sign-in is incompatible with database sessions), but
// the model must exist for the adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Single-use tokens. Auth.js uses this for its own email/OAuth flows; the
/// custom "verify your email after sign-up" flow reuses it too, with
/// `identifier` = the user's email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Journeys (Phase 2)
// ---------------------------------------------------------------------------

/// Fixed sets → Postgres enums (integrity matters; the AI reads this later).
/// Open-ended vocab (transport modes, travel styles) stays as String[] +
/// Zod validation — see src/modules/journeys/journey.schema.ts.
enum JourneyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StopType {
  ACTIVITY
  TRANSIT
  LODGING
  FOOD
  NOTE
}

/// A completed trip written up by its author. Public once `status` is
/// PUBLISHED; a DRAFT is visible only to the author. Soft-deleted via
/// `deletedAt` so references from future SavedJourney rows don't dangle.
model Journey {
  id       String        @id @default(cuid())
  authorId String
  status   JourneyStatus @default(DRAFT)

  title   String
  slug    String  @unique
  summary String?

  originName      String?
  destinationName String?
  country         String?
  region          String?
  lat             Float?
  lng             Float?

  startDate    DateTime?
  endDate      DateTime?
  durationDays Int?

  transportModes String[] @default([])
  travelStyle    String[] @default([])

  /// Integer minor units (e.g. paise) + ISO 4217 code.
  budgetAmount    Int?
  budgetCurrency  String @default("INR")
  budgetBreakdown Json?

  /// Markdown.
  description String?
  tips        String[] @default([])

  viewCount   Int       @default(0)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Full-text search vector. A Postgres GENERATED column maintained by the
  /// database (see the migration) — never written from application code, and
  /// never selected (Prisma can't represent tsvector).
  searchVector Unsupported("tsvector")?

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images        JourneyImage[]
  days          JourneyDay[]
  tags          JourneyTag[]
  savedBy       SavedJourney[]
  conversations Conversation[]
  forkedInto    Itinerary[]

  @@index([authorId])
  @@index([status, publishedAt])
  // Discovery filters (created as raw SQL in the Phase 3 migration; declared
  // here so future `migrate diff` doesn't try to drop them). The GIN index on
  // `searchVector` can't be expressed in Prisma and stays raw-only.
  @@index([country])
  @@index([budgetAmount])
  @@index([durationDays])
  @@index([travelStyle], type: Gin)
  @@index([transportModes], type: Gin)
  @@map("journeys")
}

/// A user bookmarking a published journey. Composite PK — a user can save a
/// journey at most once.
model SavedJourney {
  userId    String
  journeyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@id([userId, journeyId])
  @@index([userId, createdAt])
  @@index([journeyId])
  @@map("saved_journeys")
}

model JourneyImage {
  id         String   @id @default(cuid())
  journeyId  String
  /// Public Blob URL.
  url        String
  /// Blob pathname, kept so the file can be deleted from storage.
  storageKey String
  width      Int?
  height     Int?
  caption    String?
  position   Int      @default(0)
  /// Exactly one per journey; enforced in the service.
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@map("journey_images")
}

model JourneyDay {
  id        String    @id @default(cuid())
  journeyId String
  dayNumber Int
  title     String?
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  journey Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  stops   JourneyStop[]

  @@unique([journeyId, dayNumber])
  @@index([journeyId])
  @@map("journey_days")
}

model JourneyStop {
  id           String   @id @default(cuid())
  dayId        String
  position     Int      @default(0)
  /// Free text ("09:30", "Morning") — kept simple on purpose.
  time         String?
  type         StopType @default(ACTIVITY)
  title        String
  description  String?
  locationName String?
  lat          Float?
  lng          Float?
  cost         Int?
  costCurrency String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  day JourneyDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@map("journey_stops")
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique
  label     String
  createdAt DateTime     @default(now())
  journeys  JourneyTag[]

  @@map("tags")
}

/// Join table: normalised so Phase 3 can build tag pages and filters.
model JourneyTag {
  journeyId String
  tagId     String

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([journeyId, tagId])
  @@index([tagId])
  @@map("journey_tags")
}

// ---------------------------------------------------------------------------
// Messaging (Phase 4) — 1:1 direct messages
// ---------------------------------------------------------------------------

/// One conversation per pair of users. `pairKey` is the two user ids sorted and
/// joined ("<idA>:<idB>"), so get-or-create is a single unique lookup.
/// `journeyId` records what the conversation was started about (optional).
model Conversation {
  id            String   @id @default(cuid())
  pairKey       String   @unique
  journeyId     String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  journey      Journey?                  @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  /// Everything up to here is considered read. Defaults to join time.
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  editedAt       DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Personal itineraries (Phase 5)
// ---------------------------------------------------------------------------

enum ItineraryStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

/// Who created a plan. `AGENT` is reserved for the Phase 7 AI tool.
enum PlanOrigin {
  USER
  AGENT
}

/// A user's private trip plan. Structurally similar to a Journey's itinerary
/// but a different lifecycle and owner — hence its own tables rather than a
/// polymorphic FK (see docs/ARCHITECTURE.md).
model Itinerary {
  id              String          @id @default(cuid())
  ownerId         String
  title           String
  destinationName String?
  country         String?
  startDate       DateTime?
  endDate         DateTime?
  status          ItineraryStatus @default(DRAFT)
  /// Currency the plan's costs are entered in. Per-item costCurrency is kept
  /// for a future multi-currency feature but not surfaced yet.
  currency        String          @default("INR")
  notes           String?
  /// The published journey this was forked from, if any.
  sourceJourneyId String?
  createdBy       PlanOrigin      @default(USER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceJourney Journey?  @relation(fields: [sourceJourneyId], references: [id], onDelete: SetNull)
  days          PlanDay[]

  @@index([ownerId, updatedAt])
  @@index([sourceJourneyId])
  @@map("itineraries")
}

model PlanDay {
  id          String    @id @default(cuid())
  itineraryId String
  dayNumber   Int
  title       String?
  date        DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  itinerary Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@map("plan_days")
}

model PlanItem {
  id           String   @id @default(cuid())
  planDayId    String
  position     Int      @default(0)
  time         String?
  type         StopType @default(ACTIVITY)
  title        String
  description  String?
  locationName String?
  /// Integer minor units, in the parent itinerary's currency.
  cost         Int?
  costCurrency String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  day PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  @@index([planDayId])
  @@map("plan_items")
}

// ---------------------------------------------------------------------------
// AI foundation (Phase 6)
// ---------------------------------------------------------------------------

/// Outcome of a single AI tool invocation, mirroring the tool factory's
/// result contract (src/ai/tools/define-tool.ts).
enum AgentToolCallStatus {
  OK
  ERROR
  DENIED
  AWAITING_CONFIRMATION
}

/// Observability row written for every tool call the factory runs. Phase 7
/// links `sessionId` to the owning AgentSession; `messageId` stays null (tool
/// calls are logged mid-stream, before the assistant AgentMessage is persisted).
model AgentToolCall {
  id        String              @id @default(cuid())
  sessionId String?
  messageId String?
  userId    String?
  toolName  String
  args      Json
  result    Json
  status    AgentToolCallStatus
  latencyMs Int
  error     String?
  createdAt DateTime            @default(now())

  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message AgentMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([toolName, createdAt])
  @@map("agent_tool_calls")
}

/// One row per data change the assistant made on the user's behalf, after the
/// user confirmed it (saveJourney is inline but still audited). Distinct from
/// AgentToolCall (per-invocation observability): this is "what changed". Also
/// backs the per-session / per-tool mutation caps.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String?
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Agent orchestrator (Phase 7)
// ---------------------------------------------------------------------------

enum AgentSessionStatus {
  ACTIVE
  ARCHIVED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

/// One assistant conversation. `state` is working memory the orchestrator
/// reads/writes each turn (last search results, extracted constraints, …).
/// `summary` folds in turns that have scrolled out of the context window.
model AgentSession {
  id             String             @id @default(cuid())
  userId         String
  title          String             @default("New chat")
  state          Json               @default("{}")
  summary        String?
  status         AgentSessionStatus @default(ACTIVE)
  lastActivityAt DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  toolCalls AgentToolCall[]

  @@index([userId, lastActivityAt])
  @@map("agent_sessions")
}

/// A persisted turn. `parts` is stored exactly as the AI SDK produces it (text
/// parts, tool calls, tool results) so a session replays and renders verbatim.
model AgentMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      AgentMessageRole
  parts     Json
  createdAt DateTime         @default(now())

  session   AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolCalls AgentToolCall[]

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}
